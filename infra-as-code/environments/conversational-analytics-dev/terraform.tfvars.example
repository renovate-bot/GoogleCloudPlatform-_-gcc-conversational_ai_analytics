project_id               = "your-project-id"
region                   = "us-central1"
bq_dataset_region        = "us"
bq_testing_dataset_name  = "dfcx_analytics"
bq_agent_dataset_name    = "agent_structure"
bq_dataform_dataset_name = "dataform_ccai"

dataform_repository_name         = "dfcx_analytics"
dataform_git_repo_url            = "https://github.com/your-org/your-repo.git"
dataform_git_repo_default_branch = "main"
dataform_git_commit              = "your-git-commit-hash" # e.g., "194a68d69d3b5ccd6adba095df46889534ebdbad"
dfcx_export_table                = "your-project-id.your_dataset.your_table"

nlu_testing_execution_instances = [
  {
    schedule_name       = "dfcx-nlu-testing-example"
    agent_id            = "projects/your-project-id/locations/your-region/agents/your-agent-id"
    test_config_gcs_uri = "gs://your-bucket/your-config.csv"
    cron_schedule       = "0 * * * *" # hourly
    timezone            = "America/New_York"
  }
]

cx_test_cases_execution_instances = [
  {
    schedule_name = "dfcx-cx-test-cases-example"
    agent_id      = "projects/your-project-id/locations/your-region/agents/your-agent-id"
    cron_schedule = "0 * * * *" # hourly
    timezone      = "America/New_York"
  }
]

conversation_generator_dfcx_agent_id     = "your-agent-uuid" # e.g., "5c04f90a-f98a-4714-b67e-0a163e4ddcd3"
conversation_generator_gemini_model_name = "gemini-2.5-flash"
conversation_generator_max_turns         = 8
conversation_generator_num_conversations = 3
